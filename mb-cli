# The admin username is cached so that repeat invocations prompt only for the
# password. No secret is written to disk.
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "mb-cli")
USER_CACHE = os.path.join(CONFIG_DIR, "admin_user")


def cached_user():
    try:
        with open(USER_CACHE, encoding="utf-8") as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def cache_user(name):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(USER_CACHE, "w", encoding="utf-8") as fh:
            fh.write(name + "\n")
    except OSError:
        pass

ROW_RE = re.compile(r"<tr>(.*?)</tr>", re.S)
CELL_RE = re.compile(r"<td[^>]*>(.*?)</td>", re.S)
HEAD_RE = re.compile(r"<th[^>]*>(.*?)</th>", re.S)
ANCHOR_RE = re.compile(r'<a\b[^>]*?href="([^"]+)"[^>]*>(.*?)</a>', re.S)
TAG_RE = re.compile(r"<[^>]+>")
UPLOADS_RE = re.compile(r"<h3>Uploads</h3>(.*?)(?:<h3>|\Z)", re.S)
DISPOSITION_RE = re.compile(r'filename\*?=(?:UTF-8\'\')?"?([^";]+)"?')

ANSI = {
    "reset": "\033[0m", "dim": "\033[2m", "bold": "\033[1m",
    "cyan": "\033[36m", "green": "\033[32m", "yellow": "\033[33m", "red": "\033[31m",
}

COLOR = False


def c(name, s):
    return f"{ANSI[name]}{s}{ANSI['reset']}" if COLOR else str(s)


def err(msg):
    print(c("red", msg), file=sys.stderr)


def text_of(fragment):
    return re.sub(r"\s+", " ", html.unescape(TAG_RE.sub(" ", fragment))).strip()


def links_of(fragment):
    return [(html.unescape(h), text_of(l)) for h, l in ANCHOR_RE.findall(fragment)]


def new_entry(key, url):
    return {
        "key": key, "url": url, "name": "", "kind": "-", "content_url": "",
        "size": "", "bytes": -1, "mime": "", "created": "-", "expires": "-",
        "enc": "-", "priv": "-", "editable": "-", "hits": "-",
        "edit": "", "remove": "", "delete": "",
    }


class Client:
    # Wraps requests to the instance. A cookie jar is installed so that any
    # session established by the admin login is carried into subsequent
    # requests; plain urlopen discards Set-Cookie, which causes admin-only
    # routes to redirect back to the login form. Credentials are retained in
    # memory for the lifetime of the process to permit re-authentication.
    def __init__(self, base, timeout=15.0):
        self.base = base.rstrip("/")
        self.timeout = timeout
        self.jar = http.cookiejar.CookieJar()
        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.jar))
        self.user = None
        self.password = None
        # Reused across multiple uploads in one invocation once entered.
        self.upload_password = None
        self._needs_upload_password = None

    def url_for(self, path):
        return path if path.startswith("http") else f"{self.base}{path}"

    def open(self, path, data=None, headers=None, basic=False, timeout=-1):
        # Returns the response object; the caller closes it. The socket timeout
        # applies to individual send and receive operations as well as to
        # connection setup, so a value suited to fetching the listing will abort
        # a large upload; timeout=None disables it for that request.
        hdrs = dict(headers or {})
        if basic and self.user is not None:
            token = base64.b64encode(f"{self.user}:{self.password}".encode()).decode()
            hdrs["Authorization"] = f"Basic {token}"
        req = urllib.request.Request(self.url_for(path), data=data, headers=hdrs)
        effective = self.timeout if timeout == -1 else timeout
        return self.opener.open(req, timeout=effective)

    def requires_upload_password(self):
        # The index form renders an uploader_password field only when the
        # instance is configured with --uploader-password or
        # --file-upload-password, which makes the form itself a cheap and
        # reliable indicator, avoiding a speculative upload to discover the
        # requirement after the payload has already been transferred.

        # NOTE: this may not work as intended on mainline uBin instances...
        # I added a password field for file uploads, I don't remember if
        # that's how the upstream password-to-post-at-all works.
        if self._needs_upload_password is None:
            try:
                doc, _ = self.get_text("/")
                self._needs_upload_password = 'name="uploader_password"' in doc
            except (urllib.error.URLError, OSError):
                self._needs_upload_password = False
        return self._needs_upload_password

    def get_text(self, path, headers=None, basic=False):
        with self.open(path, headers=headers, basic=basic) as resp:
            return resp.read().decode("utf-8", "replace"), resp.url

    def admin_page(self, username=None, password=None):
        # Reproduces the /auth_admin form submission. Incorrect credentials
        # redirect to /auth_admin/incorrect rather than returning an error status.
        if username is not None:
            self.user, self.password = username, password
        body, ctype = multipart({"username": self.user, "password": self.password})
        doc, final = self._post("/admin/", body, ctype)
        if "auth_admin" in final:
            raise PermissionError("incorrect admin credentials")
        return doc

    def authenticated_get(self, path):
        # Retrieves a protected resource, escalating through the mechanisms a
        # MicroBin fork may use for admin-only routes. Returns (final_url, ok).
        final = self._try_get(path)
        if self._authorized(final):
            return final, True

        # A session may have expired or never been established; re-submit the
        # login form so the jar receives a current cookie, then retry.
        if self.user is not None:
            try:
                self.admin_page()
            except (PermissionError, urllib.error.HTTPError):
                pass
            final = self._try_get(path)
            if self._authorized(final):
                return final, True

            # Some deployments protect the route with HTTP Basic instead.
            final = self._try_get(path, basic=True)
            if self._authorized(final):
                return final, True

            # Last resort: submit the credentials to the route directly, as the
            # private-removal form does.
            body, ctype = multipart({"username": self.user, "password": self.password})
            try:
                _, final = self._post(path, body, ctype)
            except urllib.error.HTTPError as e:
                final = f"HTTP {e.code}"
            if self._authorized(final):
                return final, True
        return final, False

    @staticmethod
    def _authorized(final):
        return not ("auth_admin" in final or "auth_remove_private" in final
                    or final.startswith("HTTP "))

    def _try_get(self, path, basic=False):
        try:
            with self.open(path, basic=basic) as resp:
                return resp.url
        except urllib.error.HTTPError as e:
            return f"HTTP {e.code}"

    def _post(self, path, body, ctype):
        with self.open(path, data=body, headers={"Content-Type": ctype}) as resp:
            return resp.read().decode("utf-8", "replace"), resp.url


def multipart(fields):
    # Builds a minimal multipart/form-data body; the admin login and the
    # private-removal form both read multipart rather than urlencoded fields.
    boundary = "----pls" + base64.b16encode(os.urandom(8)).decode().lower()
    body = b""
    for name, value in fields.items():
        body += (f"--{boundary}\r\n"
                 f'Content-Disposition: form-data; name="{name}"\r\n\r\n'
                 f"{value}\r\n").encode()
    body += f"--{boundary}--\r\n".encode()
    return body, f"multipart/form-data; boundary={boundary}"


# Accepted by is_valid_expiration; the instance additionally caps the value at
# its configured max_expiry, silently rejecting anything longer.
